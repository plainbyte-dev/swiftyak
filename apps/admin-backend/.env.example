PORT=4000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/courierdesk

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,https://swift-yak-admin.vercel.app


# SMTP for password reset emails (Google Workspace: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@swiftyak.com.np
SMTP_PASS=your_app_password
MAIL_FROM="SwiftYak <info@swiftyak.com.np>"

# Admin frontend URL used in reset links
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRES_MINUTES=60
